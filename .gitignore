# Dependencies and build output
node_modules/
client/dist/
dist/
*.tsbuildinfo

# Settings and secrets (copy .env.example to .env)
.env
.env.*
!.env.example

# Game data: the database, its journal files and backups (never commit these)
*.db
*.db-wal
*.db-shm
*.db-journal
server/data/backups/

