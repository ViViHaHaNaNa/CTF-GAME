# Don't run dependencies' install scripts. None of ours need one: better-sqlite3 ships ready-made
# binaries for Windows, Mac and Linux (prebuilds/), and esbuild/rollup come as per-platform packages.
# Without this, npm tries to compile better-sqlite3 from source (it has a binding.gyp), which fails on
# any laptop without Visual Studio / Xcode build tools. `npm run ...` scripts still run as normal.
ignore-scripts=true
engine-strict=true
