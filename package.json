{
  "name": "iete-sf-site",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run build && npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "loadtest": "tsx server/scripts/loadtest.ts",
    "backup": "tsx server/scripts/backup.ts",
    "ui-audit": "tsx server/scripts/ui-audit.ts",
    "bots": "tsx server/scripts/bots.ts",
    "reset": "tsx server/scripts/reset.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "playwright-core": "^1.48.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
