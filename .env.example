# Code Siege settings. Copy this file to `.env` (same folder) and change what you need.
# `.env` is gitignored: never commit it. Real environment variables override this file.
# Every line is optional: the values shown are the defaults.

# --- Development -------------------------------------------------------------------------------
# DEV_MODE=true: a fresh (empty) world gets 8 bot accounts, one per Main Tower level
# (log in as "Bot Lv1".."Bot Lv8" with roll number BOT01..BOT08), and a crate waits to be claimed.
# MUST be false (or absent) for the real event. `npm start` (the event build) ignores it anyway
# and refuses to start if a database still has bot accounts.
DEV_MODE=false

# --- Admin -------------------------------------------------------------------------------------
# Passphrase for /siege/admin/. Leave empty to turn the admin page off.
# For the event: a long, unguessable one, known to the organisers only.
SIEGE_ADMIN_PASS=

# --- Ports and addresses -----------------------------------------------------------------------
# The game server. With `npm start` it also serves the website on this port.
SIEGE_PORT=3000
# 0.0.0.0 = reachable from phones on the same wifi. 127.0.0.1 = this computer only.
SIEGE_HOST=0.0.0.0
# The website during `npm run dev` (Vite, hot reload).
SIEGE_DEV_PORT=5173
# Where the website finds the game server. Empty = the address the page was loaded from (right for
# `npm run dev` and `npm start` on one computer). Only set it if the game server runs somewhere else,
# e.g. VITE_SIEGE_SERVER_URL=https://siege.example.org
VITE_SIEGE_SERVER_URL=

# --- Files (relative paths are from this folder) ------------------------------------------------
# The whole game state (gitignored, never commit it).
SIEGE_DB=server/data/siege.db
SIEGE_BACKUPS=server/data/backups
SIEGE_QUESTIONS=server/data/questions.json
